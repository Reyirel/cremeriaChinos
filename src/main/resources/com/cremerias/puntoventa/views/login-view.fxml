<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.CustomTextField?>
<?import atlantafx.base.controls.Message?>
<?import atlantafx.base.controls.PasswordTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox fx:id="raiz" styleClass="login" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.cremerias.puntoventa.ui.LoginController">

    <!-- Panel de marca -->
    <StackPane fx:id="panelMarca" styleClass="login-marca" HBox.hgrow="ALWAYS" minWidth="400" prefWidth="560">
        <Circle styleClass="decoracion" radius="220" StackPane.alignment="TOP_RIGHT" translateX="120" translateY="-120"/>
        <Circle styleClass="decoracion" radius="160" StackPane.alignment="BOTTOM_LEFT" translateX="-70" translateY="80"/>
        <Circle styleClass="decoracion-suave" radius="70" StackPane.alignment="BOTTOM_RIGHT" translateX="-60" translateY="-110"/>

        <VBox fx:id="contenidoMarca" styleClass="marca-contenido" spacing="30" maxWidth="420"
              maxHeight="-Infinity" alignment="CENTER_LEFT">
            <StackPane styleClass="marca-logo" maxWidth="-Infinity" maxHeight="-Infinity">
                <FontIcon iconLiteral="mdi2c-cheese" iconSize="46"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="Cremería" styleClass="marca-titulo"/>
                <Label text="Punto de Venta" styleClass="marca-subtitulo"/>
            </VBox>
            <Label styleClass="marca-lema" wrapText="true"
                   text="Vende, cobra y controla tu tienda aunque se caiga el internet."/>
            <VBox spacing="16">
                <HBox styleClass="marca-caracteristica" spacing="14" alignment="CENTER_LEFT">
                    <StackPane styleClass="marca-caracteristica-icono">
                        <FontIcon iconLiteral="mdi2w-wifi-off" iconSize="18"/>
                    </StackPane>
                    <Label text="Funciona sin conexión a internet"/>
                </HBox>
                <HBox styleClass="marca-caracteristica" spacing="14" alignment="CENTER_LEFT">
                    <StackPane styleClass="marca-caracteristica-icono">
                        <FontIcon iconLiteral="mdi2s-shield-lock-outline" iconSize="18"/>
                    </StackPane>
                    <Label text="Tus datos protegidos y respaldados"/>
                </HBox>
                <HBox styleClass="marca-caracteristica" spacing="14" alignment="CENTER_LEFT">
                    <StackPane styleClass="marca-caracteristica-icono">
                        <FontIcon iconLiteral="mdi2c-cloud-sync-outline" iconSize="18"/>
                    </StackPane>
                    <Label text="Se sincroniza con la nube al reconectar"/>
                </HBox>
            </VBox>
        </VBox>

        <Label text="© Cremería · v1.0" styleClass="marca-pie" StackPane.alignment="BOTTOM_LEFT">
            <StackPane.margin>
                <Insets left="40" bottom="28"/>
            </StackPane.margin>
        </Label>
    </StackPane>

    <!-- Formulario -->
    <StackPane styleClass="login-panel" HBox.hgrow="ALWAYS" minWidth="440" prefWidth="560">
        <Button fx:id="botonTema" onAction="#onAlternarTema" StackPane.alignment="TOP_RIGHT"
                styleClass="button-icon, flat, rounded" focusTraversable="false">
            <StackPane.margin>
                <Insets top="20" right="20"/>
            </StackPane.margin>
        </Button>

        <VBox fx:id="formulario" styleClass="login-form" maxWidth="380" maxHeight="-Infinity" spacing="22">
            <VBox spacing="6">
                <Label text="Bienvenido" styleClass="login-titulo"/>
                <Label text="Inicia sesión con tu usuario para continuar." styleClass="login-subtitulo"
                       wrapText="true"/>
            </VBox>

            <Message fx:id="mensajeError" styleClass="danger" title="No se pudo iniciar sesión">
                <graphic>
                    <FontIcon iconLiteral="mdi2a-alert-circle-outline"/>
                </graphic>
            </Message>

            <VBox spacing="8">
                <Label text="Usuario" styleClass="campo-etiqueta" labelFor="$campoUsuario"/>
                <CustomTextField fx:id="campoUsuario" promptText="Ej. cajero" styleClass="campo-login">
                    <left>
                        <FontIcon iconLiteral="mdi2a-account-outline"/>
                    </left>
                </CustomTextField>
            </VBox>

            <VBox spacing="8">
                <Label text="Contraseña" styleClass="campo-etiqueta" labelFor="$campoPassword"/>
                <PasswordTextField fx:id="campoPassword" promptText="Tu contraseña" styleClass="campo-login">
                    <left>
                        <FontIcon iconLiteral="mdi2l-lock-outline"/>
                    </left>
                </PasswordTextField>
                <Label fx:id="avisoMayusculas" text="Bloq Mayús está activado" styleClass="aviso-mayusculas">
                    <graphic>
                        <FontIcon iconLiteral="mdi2a-alert-circle-outline"/>
                    </graphic>
                </Label>
            </VBox>

            <CheckBox fx:id="recordarUsuario" text="Recordar mi usuario en este equipo"/>

            <Button fx:id="botonEntrar" text="Iniciar sesión" onAction="#onEntrar" defaultButton="true"
                    maxWidth="Infinity" styleClass="accent, large, boton-entrar">
                <graphic>
                    <FontIcon iconLiteral="mdi2l-login"/>
                </graphic>
            </Button>

            <Label text="¿Olvidaste tu contraseña? Pide al administrador que la restablezca."
                   styleClass="login-ayuda" wrapText="true"/>
        </VBox>

        <HBox fx:id="barraEstado" alignment="CENTER" maxHeight="-Infinity" StackPane.alignment="BOTTOM_CENTER">
            <StackPane.margin>
                <Insets bottom="24"/>
            </StackPane.margin>
        </HBox>
    </StackPane>
</HBox>
